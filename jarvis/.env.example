# Copy this file to .env and fill in your values
# jarvis/.env

# REQUIRED: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# OPTIONAL: Trading system URL (if running locally or on cloud)
# TRADING_API_URL=http://localhost:8000
# or your Render/Railway URL:
# TRADING_API_URL=https://your-app.onrender.com

# OPTIONAL: n8n webhook integrations
# Format: {"workflow_name": "webhook_url", ...}
# N8N_WEBHOOKS={"send_report": "http://localhost:5678/webhook/abc123", "morning_brief": "http://localhost:5678/webhook/def456"}

# OPTIONAL: Google Sheets for client data
# GOOGLE_CREDENTIALS_PATH=C:\path\to\credentials.json
# DEFAULT_SHEET_ID=your_google_sheet_id_here

# OPTIONAL: Model selection
# JARVIS_MODEL=claude-haiku-4-5-20251001
# JARVIS_MODEL=claude-sonnet-4-6
# JARVIS_MODEL=claude-opus-4-8
